{
    "name": "nguyenphutrong/telescope-mcp",
    "description": "Local read-only MCP access to recorded Laravel Telescope events",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.61.1|^13.12",
        "laravel/telescope": "^5.24",
        "laravel/mcp": "^0.9.5"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {"psr-4": {"TelescopeMcp\\": "src/"}},
    "autoload-dev": {"psr-4": {"TelescopeMcp\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["TelescopeMcp\\TelescopeMcpServiceProvider"]}},
    "scripts": {"test": "phpunit"},
    "config": {"sort-packages": true}
}
